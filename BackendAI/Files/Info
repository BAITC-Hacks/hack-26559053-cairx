## 4. СЛОЙ ИНТЕГРАЦИИ LLM (THE EXPLAINER)

После того как Pandas высчитал топ-3 активности, данные передаются в генератор объяснений.

**Код архитектуры LLM (Dual-Provider):**

```python
import os
import logging
from openai import OpenAI

logger = logging.getLogger(__name__)

# Инициализация OpenAI
openai_client = OpenAI(api_key=os.getenv("OPENAI_API_KEY"), timeout=4.0) if os.getenv("OPENAI_API_KEY") else None

# Инициализация NVIDIA NIM
nvidia_client = OpenAI(
    base_url="https://integrate.api.nvidia.com/v1",
    api_key=os.getenv("NVIDIA_API_KEY"),
    timeout=4.0
) if os.getenv("NVIDIA_API_KEY") else None

def generate_reasoning(employee_name, target_grade, event_title, skill_name, current_level, required_level, is_critical, past_dropouts):
    # АВАРИЙНЫЙ ШАБЛОН (Уровень 3)
    fallback_text = (
        f"Активность «{event_title}» сократит разрыв по навыку {skill_name} "
        f"({current_level} → {required_level}). Это {'критично' if is_critical else 'полезно'} для грейда {target_grade}."
    )

    prompt = f"""
    Объясни сотруднику {employee_name} в 2 предложениях, почему ему рекомендована активность "{event_title}".
    Факты:
    - Навык: {skill_name} (текущий {current_level}, надо {required_level} для грейда {target_grade}).
    - Критичность: {'Блокер для промоушена' if is_critical else 'Развивающий'}.
    - Прогулов подобных курсов: {past_dropouts}.
    """

    # УРОВЕНЬ 1: OpenAI
    if openai_client:
        try:
            return openai_client.chat.completions.create(
                model="gpt-4o-mini",
                messages=[{"role": "system", "content": "Ты HR-советник."}, {"role": "user", "content": prompt}],
                max_tokens=150, temperature=0.3
            ).choices[0].message.content.strip()
        except Exception as e:
            logger.warning(f"OpenAI failed: {e}. Fallback to NVIDIA.")

    # УРОВЕНЬ 2: NVIDIA NIM
    if nvidia_client:
        try:
            return nvidia_client.chat.completions.create(
                model="meta/llama-3.1-70b-instruct",
                messages=[{"role": "system", "content": "Ты HR-советник."}, {"role": "user", "content": prompt}],
                max_tokens=150, temperature=0.3
            ).choices[0].message.content.strip()
        except Exception as e:
            logger.warning(f"NVIDIA failed: {e}. Fallback to Template.")

    return fallback_text

```

