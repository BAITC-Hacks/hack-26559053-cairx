# App Settings
PROJECT_NAME="Career Quest"
VERSION="2.0.0"
API_V1_STR="/api/v1"
DEBUG=false

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# AI Providers
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
NVIDIA_API_KEY=""
NVIDIA_MODEL="meta/llama-3.1-70b-instruct"
LLM_TIMEOUT_SECONDS=4

# Dataset Paths
DATA_DIR="dataset"
SNAPSHOT_DATE="2026-10-01"
MAX_UPLOAD_BYTES=10485760

# Reference only. Export these values into the process environment;
# the application deliberately does not read .env files.
