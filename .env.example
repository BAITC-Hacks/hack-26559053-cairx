# Application
PROJECT_NAME="Career Quest"
VERSION="2.0.0"
DESCRIPTION="Employee development recommendations with deterministic scoring."
API_V1_STR="/api/v1"
DEBUG=false

# Server
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS="http://localhost:8000"

# Optional LLM providers. Leave keys empty to use deterministic local explanations.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
NVIDIA_API_KEY=""
NVIDIA_MODEL="meta/llama-3.1-70b-instruct"
# Per-provider timeout; all providers share the total deadline below.
LLM_TIMEOUT_SECONDS=8
LLM_TOTAL_TIMEOUT_SECONDS=9

# Dataset and upload limits
DATA_DIR="dataset"
SNAPSHOT_DATE="2026-10-01"
MAX_UPLOAD_BYTES=10485760
